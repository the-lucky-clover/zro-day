{
    "manifest_version": 3,
    "name": "Zro-Day Browser Watchdog",
    "short_name": "ZroDayWatchdog",
    "version": "1.0",
    "description": "Advanced cybersecurity protection against phishing, malware, and state-level spyware threats for macOS.",
    
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },
    
    "permissions": [
        "activeTab",
        "storage",
        "webRequest",
        "declarativeNetRequest",
        "scripting",
        "tabs",
        "notifications",
        "nativeMessaging"
    ],
    
    "host_permissions": [
        "<all_urls>"
    ],
    
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "phishing_rules",
                "enabled": true,
                "path": "rules/phishing_rules.json"
            },
            {
                "id": "malware_rules",
                "enabled": true,
                "path": "rules/malware_rules.json"
            },
            {
                "id": "tracking_rules",
                "enabled": true,
                "path": "rules/tracking_rules.json"
            },
            {
                "id": "spyware_rules",
                "enabled": true,
                "path": "rules/spyware_rules.json"
            }
        ]
    },
    
    "web_accessible_resources": [
        {
            "resources": [
                "injected/*.js",
                "popup.html",
                "options.html"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    
    "action": {
        "default_popup": "popup.html",
        "default_title": "Zro-Day Browser Watchdog",
        "default_icon": {
            "16": "images/icon-16.png",
            "32": "images/icon-32.png",
            "48": "images/icon-48.png",
            "96": "images/icon-96.png"
        }
    },
    
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
}
